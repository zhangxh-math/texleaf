{
  "name": "texleaf",
  "displayName": "TeXLeaf — Fast LaTeX Snippets",
  "description": "安全、可定制的 LaTeX 自动片段、AI 写作检查、Math Preview 与 Zotero 引用管理。",
  "version": "0.8.9",
  "publisher": "zhangxh-math",
  "author": {
    "name": "zhangxh-math",
    "url": "https://github.com/zhangxh-math"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhangxh-math/texleaf.git"
  },
  "homepage": "https://github.com/zhangxh-math/texleaf#readme",
  "bugs": {
    "url": "https://github.com/zhangxh-math/texleaf/issues"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0B1F33",
    "theme": "dark"
  },
  "pricing": "Free",
  "markdown": "github",
  "qna": "marketplace",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Snippets",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "latex",
    "tex",
    "bibtex",
    "zotero",
    "citation",
    "math",
    "preview",
    "snippets",
    "snippet-leaf",
    "grammar",
    "writing",
    "deepseek",
    "openai"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "TeXLeaf 在受限模式下继续使用用户的全局片段库；项目级附加文件、Zotero 引用写入与会发送正文的 AI 写作助手会被禁用。",
      "restrictedConfigurations": [
        "texleaf.snippetFiles",
        "texleaf.bibliographyFile",
        "texleaf.zoteroPort",
        "texleaf.zoteroLibrary",
        "texleaf.mathPreview.macros",
        "texleaf.aiWriting.enabled",
        "texleaf.aiWriting.automaticReview",
        "texleaf.aiWriting.inlineCompletions",
        "texleaf.aiWriting.provider",
        "texleaf.aiWriting.deepseekModel",
        "texleaf.aiWriting.deepseekBaseUrl",
        "texleaf.aiWriting.openaiModel",
        "texleaf.aiWriting.openaiBaseUrl",
        "texleaf.aiWriting.language",
        "texleaf.aiWriting.style",
        "texleaf.aiWriting.reviewDelayMs",
        "texleaf.aiWriting.completionDelayMs",
        "texleaf.aiWriting.maxParagraphLength",
        "texleaf.aiWriting.maxDocumentLength"
      ]
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onLanguage:latex",
    "onLanguage:tex",
    "onLanguage:bibtex",
    "onCommand:texleaf.openTemplateFile",
    "onCommand:texleaf.pickCitation",
    "onCommand:texleaf.refreshZotero",
    "onCommand:texleaf.toggleMathPreview",
    "onCommand:texleaf.refreshMathPreview",
    "onStartupFinished",
    "onView:texleaf.snippets",
    "onView:texleaf.aiIssues"
  ],
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "test:compile": "tsc -p tsconfig.test.json",
    "test": "pnpm run test:compile && node --test .test-dist/test/core.test.js .test-dist/test/aiProse.test.js .test-dist/test/aiIssuePersistence.test.js .test-dist/test/deepseekClient.test.js .test-dist/test/openaiClient.test.js .test-dist/test/issueLocation.test.js .test-dist/test/providerIdentity.test.js .test-dist/test/defaultSnippets.test.js .test-dist/test/defaultTemplates.test.js .test-dist/test/snippetManagerWebview.test.js .test-dist/test/citation.test.js .test-dist/test/mathPreview.test.js .test-dist/test/mathPreviewAppearance.test.js .test-dist/test/mathPreviewLayout.test.js .test-dist/test/referenceMatcher.test.js .test-dist/test/zoteroClient.test.js",
    "test:extension-host:run": "node test/run-extension-host.cjs",
    "test:extension-host": "pnpm run compile && pnpm run test:extension-host:run",
    "test:bundle": "node test/bundle-smoke.cjs && node test/math-preview-worker.cjs",
    "verify": "pnpm run check && pnpm run test && pnpm run compile && pnpm run test:bundle",
    "release:verify": "pnpm run verify && pnpm run test:extension-host:run",
    "package": "pnpm run release:verify && vsce package --no-dependencies --githubBranch main"
  },
  "dependencies": {
    "@mathjax/mathjax-newcm-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.98.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  },
  "contributes": {
    "configurationDefaults": {
      "[latex]": {
        "editor.wordBasedSuggestions": "off"
      },
      "[tex]": {
        "editor.wordBasedSuggestions": "off"
      }
    },
    "commands": [
      {
        "command": "texleaf.openSnippetFile",
        "title": "TeXLeaf: 打开高级 Snippet JSONC",
        "icon": "$(json)"
      },
      {
        "command": "texleaf.openSnippetEditor",
        "title": "TeXLeaf: 管理 Snippet 与模板",
        "icon": "$(edit)"
      },
      {
        "command": "texleaf.openTemplateFile",
        "title": "TeXLeaf: 管理 TeX 模板",
        "icon": "$(file-code)"
      },
      {
        "command": "texleaf.restoreDefaultSnippets",
        "title": "TeXLeaf: 恢复默认片段",
        "icon": "$(discard)"
      },
      {
        "command": "texleaf.reloadSnippets",
        "title": "TeXLeaf: 重载片段",
        "icon": "$(refresh)"
      },
      {
        "command": "texleaf.pickSnippet",
        "title": "TeXLeaf: 搜索并插入片段",
        "icon": "$(search)"
      },
      {
        "command": "texleaf.toggle",
        "title": "TeXLeaf: 切换启用状态"
      },
      {
        "command": "texleaf.importSnippets",
        "title": "TeXLeaf: 导入片段"
      },
      {
        "command": "texleaf.exportSnippets",
        "title": "TeXLeaf: 导出片段"
      },
      {
        "command": "texleaf.wrapSelection",
        "title": "TeXLeaf: 用片段包裹所选内容"
      },
      {
        "command": "texleaf.insertSnippet",
        "title": "插入片段"
      },
      {
        "command": "texleaf.handleTab",
        "title": "TeXLeaf: 展开或跳出"
      },
      {
        "command": "texleaf.matrixEnter",
        "title": "TeXLeaf: 数学环境智能换行"
      },
      {
        "command": "texleaf.matrixExit",
        "title": "TeXLeaf: 跳出矩阵"
      },
      {
        "command": "texleaf.handleSpace",
        "title": "TeXLeaf: 用空格展开片段"
      },
      {
        "command": "texleaf.deleteEmptyMathDelimiters",
        "title": "TeXLeaf: 删除空数学定界符"
      },
      {
        "command": "texleaf.pickCitation",
        "title": "TeXLeaf: 显示参考文献补全",
        "icon": "$(references)"
      },
      {
        "command": "texleaf.refreshZotero",
        "title": "TeXLeaf: 刷新 Zotero 参考文献缓存",
        "icon": "$(refresh)"
      },
      {
        "command": "texleaf.toggleMathPreview",
        "title": "TeXLeaf: 切换 Math Preview"
      },
      {
        "command": "texleaf.refreshMathPreview",
        "title": "TeXLeaf: 刷新 Math Preview",
        "icon": "$(refresh)"
      },
      {
        "command": "texleaf.dismissMathPreview",
        "title": "TeXLeaf: 关闭当前 Math Preview"
      },
      {
        "command": "texleaf.aiWriting.toggle",
        "title": "TeXLeaf: 切换 AI 写作助手",
        "icon": "$(sparkle)"
      },
      {
        "command": "texleaf.aiWriting.setApiKey",
        "title": "TeXLeaf: 设置当前 AI 服务商 API Key"
      },
      {
        "command": "texleaf.aiWriting.clearApiKey",
        "title": "TeXLeaf: 清除当前 AI 服务商 API Key"
      },
      {
        "command": "texleaf.aiWriting.reviewParagraph",
        "title": "TeXLeaf: AI 检查当前段落或选区"
      },
      {
        "command": "texleaf.aiWriting.reviewDocument",
        "title": "TeXLeaf: AI 检查当前文档",
        "icon": "$(refresh)"
      },
      {
        "command": "texleaf.aiWriting.rewriteSelection",
        "title": "TeXLeaf: AI 改写选区或当前句"
      },
      {
        "command": "texleaf.aiWriting.triggerCompletion",
        "title": "TeXLeaf: 触发 AI 行内补全"
      },
      {
        "command": "texleaf.aiWriting.clearDiagnostics",
        "title": "TeXLeaf: 清除 AI 写作问题",
        "icon": "$(clear-all)"
      },
      {
        "command": "texleaf.aiWriting.showIssues",
        "title": "TeXLeaf: 显示 AI 写作问题列表",
        "icon": "$(list-tree)"
      },
      {
        "command": "texleaf.aiWriting.applyAll",
        "title": "TeXLeaf: 应用当前全部 AI 建议",
        "icon": "$(check-all)"
      },
      {
        "command": "texleaf.aiIssues.reveal",
        "title": "TeXLeaf: 定位 AI 写作问题",
        "icon": "$(go-to-file)"
      },
      {
        "command": "texleaf.aiIssues.apply",
        "title": "TeXLeaf: 应用这条 AI 建议",
        "icon": "$(check)"
      },
      {
        "command": "texleaf.aiIssues.ignore",
        "title": "TeXLeaf: 本次会话忽略这条 AI 建议",
        "icon": "$(close)"
      }
    ],
    "keybindings": [
      {
        "command": "texleaf.handleTab",
        "key": "tab",
        "when": "texleaf.snippetTabActionAvailable && editorTextFocus && !editorReadonly && !editorTabMovesFocus && !renameInputVisible"
      },
      {
        "command": "texleaf.handleTab",
        "key": "tab",
        "when": "texleaf.tabActionAvailable && editorTextFocus && !editorReadonly && !editorTabMovesFocus && !suggestWidgetVisible && !renameInputVisible && !inlineSuggestionVisible && !inSnippetMode"
      },
      {
        "command": "texleaf.matrixEnter",
        "key": "enter",
        "when": "texleaf.enterActionAvailable && editorTextFocus && !editorReadonly && !suggestWidgetVisible && !renameInputVisible"
      },
      {
        "command": "texleaf.matrixExit",
        "key": "shift+enter",
        "when": "texleaf.matrixActionAvailable && editorTextFocus && !editorReadonly && !suggestWidgetVisible && !renameInputVisible"
      },
      {
        "command": "texleaf.pickSnippet",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus && texleaf.enabled"
      },
      {
        "command": "texleaf.handleSpace",
        "key": "space",
        "when": "texleaf.manualSpaceActionAvailable && editorTextFocus && !editorReadonly && !suggestWidgetVisible && !renameInputVisible && !inSnippetMode"
      },
      {
        "command": "texleaf.deleteEmptyMathDelimiters",
        "key": "backspace",
        "when": "texleaf.emptyMathDelimiters && editorTextFocus && !editorReadonly && !suggestWidgetVisible && !renameInputVisible && !inSnippetMode"
      },
      {
        "command": "texleaf.dismissMathPreview",
        "key": "escape",
        "when": "texleaf.mathPreviewVisible && editorTextFocus && !suggestWidgetVisible && !renameInputVisible && !inlineSuggestionVisible"
      }
    ],
    "configuration": [
      {
        "title": "TeXLeaf · 片段",
        "properties": {
        "texleaf.enabled": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "启用 TeXLeaf。"
        },
        "texleaf.autoSnippets": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "键入带 A 选项的触发器后立即展开。"
        },
        "texleaf.manualTrigger": {
          "scope": "resource",
          "type": "string",
          "enum": [
            "tab",
            "space"
          ],
          "enumDescriptions": [
            "按 Tab 展开非自动片段。",
            "按空格展开非自动片段。"
          ],
          "default": "tab",
          "description": "非自动片段的触发按键。"
        },
        "texleaf.autoFraction": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "在数学环境中键入 / 时把左侧表达式转换为分式。"
        },
        "texleaf.autoFractionCommand": {
          "scope": "resource",
          "type": "string",
          "default": "\\frac",
          "description": "自动分式使用的 LaTeX 命令，例如 \\frac、\\dfrac 或 \\tfrac。"
        },
        "texleaf.autoEnlargeBrackets": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "片段生成分式、求和或积分后，将包围它的括号转换为 \\left/\\right。"
        },
        "texleaf.visualSnippets": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "允许单字符 visual 片段包裹选区。"
        },
        "texleaf.matrixShortcuts": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "启用矩阵/align 的 Tab 插列、Enter 插行、Shift+Enter 跳出，以及可换行数学环境中匹配 \\left…\\right… 的安全跨行 Enter。"
        },
        "texleaf.tabout": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "数学环境中用 Tab 跳到下一个闭括号或环境外。"
        },
        "texleaf.skipPairedClosingCharacters": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "光标位于现有 )、] 或 } 前时，键入相同字符只跳过它。"
        },
        "texleaf.autoDeleteMathDelimiters": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "在空的 $…$、\\(…\\) 或 \\[...\\] 中按 Backspace 时删除整对定界符。"
        },
        "texleaf.colorizeBrackets": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "在数学环境中按嵌套深度给配对括号着色。"
        },
        "texleaf.highlightActiveBracketPair": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "突出显示光标附近或包围光标的括号对。"
        },
        "texleaf.enableCompletions": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "在补全列表中显示可用片段。"
        },
        "texleaf.languageIds": {
          "scope": "resource",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "latex",
            "tex",
            "bibtex"
          ],
          "description": "启用 TeXLeaf 的 VS Code 语言 ID；编辑功能仍只在已保存的 .tex 或 .bib 文件中生效。"
        },
        "texleaf.snippetFiles": {
          "scope": "resource",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "可选：相对每个工作区目录额外加载的安全 JSON/JSONC 片段文件。全局片段始终从扩展的全局存储加载，不需要在这里配置；未信任工作区会忽略此项目级设置。"
        },
        "texleaf.excludedEnvironments": {
          "scope": "resource",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "verbatim",
            "lstlisting",
            "minted"
          ],
          "description": "不运行自动片段和自动分式的 LaTeX 环境。"
        },
        "texleaf.matrixEnvironments": {
          "scope": "resource",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "matrix",
            "pmatrix",
            "bmatrix",
            "Bmatrix",
            "vmatrix",
            "Vmatrix",
            "array",
            "cases",
            "align",
            "align*",
            "aligned"
          ],
          "description": "启用矩阵快捷键的环境名称。"
        },
        "texleaf.autoFractionBreakingCharacters": {
          "scope": "resource",
          "type": "string",
          "default": "+-=,;:&",
          "description": "自动分式向左扫描时用于终止分子的字符。"
        },
        "texleaf.autoEnlargeTriggers": {
          "scope": "resource",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "\\frac",
            "\\sum",
            "\\prod",
            "\\int",
            "\\lim"
          ],
          "description": "括号内出现这些 LaTeX 命令时自动添加 \\left/\\right。"
        },
        "texleaf.maxRegexScanLength": {
          "scope": "resource",
          "type": "integer",
          "default": 512,
          "minimum": 64,
          "maximum": 8192,
          "description": "正则触发器最多检查光标前多少个字符。"
        },
        "texleaf.wordDelimiters": {
          "scope": "resource",
          "type": "string",
          "default": "., +-\\n\\t:;!?\\/{}[]()=~$",
          "description": "带 w 选项的片段可接受的词边界字符；\\n 与 \\t 会转换为换行和制表符。"
        }
      }
    },
    {
      "title": "TeXLeaf · 文献",
      "properties": {
        "texleaf.zoteroCitations": {
          "order": 1,
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "Zotero 引用功能总开关：启用项目 bibliography 与 Zotero 联动的原生引用补全。未信任工作区中始终停用。"
        },
        "texleaf.autoShowCitationPicker": {
          "order": 4,
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "光标进入配置的 \\cite{…} 类命令参数时自动打开 VS Code 原生引用补全；关闭后仍可运行“TeXLeaf: 显示参考文献补全”。"
        },
        "texleaf.bibliographyFile": {
          "order": 2,
          "scope": "resource",
          "type": "string",
          "default": "reference.bib",
          "description": "可自定义的项目内相对 .bib 路径，默认 reference.bib。简单文件名会优先使用从当前 TeX 文件向工作区根查找到的最近同名文件；不存在时在工作区根创建。"
        },
        "texleaf.citationCommands": {
          "order": 5,
          "scope": "resource",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\\\?[A-Za-z@]+\\*?$"
          },
          "default": [
            "cite",
            "citep",
            "citet",
            "Cite",
            "Citet",
            "autocite",
            "parencite",
            "textcite",
            "footcite",
            "supercite"
          ],
          "description": "触发原生引用补全的 LaTeX 命令名；可带或不带开头反斜杠，星号变体会自动兼容。"
        },
        "texleaf.zoteroPort": {
          "order": 7,
          "scope": "resource",
          "type": "integer",
          "default": 23119,
          "minimum": 1,
          "maximum": 65535,
          "description": "Zotero/Better BibTeX 本机端口。连接固定限制为 127.0.0.1；Juris-M 通常使用 24119。"
        },
        "texleaf.zoteroLibrary": {
          "order": 6,
          "scope": "resource",
          "type": "string",
          "default": "My Library",
          "description": "Zotero 库名称或内部数字 ID；默认读取 My Library，也可指定群组库。"
        },
        "texleaf.zoteroRequestTimeoutMs": {
          "order": 8,
          "scope": "resource",
          "type": "integer",
          "default": 10000,
          "minimum": 500,
          "maximum": 60000,
          "description": "Zotero/Better BibTeX 本机请求的超时时间（毫秒）。"
        },
        "texleaf.zoteroCacheSeconds": {
          "order": 9,
          "scope": "resource",
          "type": "integer",
          "default": 30,
          "minimum": 0,
          "maximum": 3600,
          "description": "Zotero 参考文献列表在内存中的缓存秒数；可随时运行刷新命令清除。"
        },
        "texleaf.bibliographyFormat": {
          "order": 3,
          "scope": "resource",
          "type": "string",
          "enum": [
            "bibtex",
            "biblatex"
          ],
          "enumDescriptions": [
            "把 Zotero 新条目以 BibTeX 格式追加到 bibliography。",
            "把 Zotero 新条目以 BibLaTeX 格式追加到 bibliography。"
          ],
          "default": "bibtex",
          "description": "从 Zotero 导入新条目时使用的 bibliography 格式；默认 BibTeX，已有条目不会被重新格式化。"
        }
      }
    },
    {
      "title": "TeXLeaf · AI 写作",
      "properties": {
        "texleaf.aiWriting.enabled": {
          "order": 1,
          "scope": "application",
          "type": "boolean",
          "default": false,
          "description": "AI 写作助手总开关。默认关闭；首次使用还必须确认会发送已命名 .tex 的当前编辑器正文（可能含尚未保存的编辑），并在 VS Code SecretStorage 中保存当前服务商的 API Key。未信任工作区中始终停用。"
        },
        "texleaf.aiWriting.automaticReview": {
          "order": 2,
          "scope": "application",
          "type": "boolean",
          "default": true,
          "description": "启用总开关后，停止键入时自动检查当前改动的 LaTeX 正文句子。完整句子只作为检查上下文；与局部编辑不相交且仍精确有效的同句及其他问题会继续保留。"
        },
        "texleaf.aiWriting.inlineCompletions": {
          "order": 3,
          "scope": "application",
          "type": "boolean",
          "default": true,
          "description": "启用总开关后，为正文提供 AI 词语和句子行内补全。每次实际请求都可能产生 API 用量。"
        },
        "texleaf.aiWriting.provider": {
          "order": 4,
          "scope": "application",
          "type": "string",
          "enum": [
            "deepseek",
            "openai"
          ],
          "enumDescriptions": [
            "使用 DeepSeek Chat Completions API；可单独配置官方或兼容服务的 Base URL。",
            "使用 OpenAI Responses API；可配置完整兼容 Responses 与 Structured Outputs 的 Base URL。"
          ],
          "default": "deepseek",
          "description": "AI 写作请求使用的协议。切换服务商或任一 Base URL 后，都需要为规范化后的目标单独确认正文传输并设置对应 API Key。"
        },
        "texleaf.aiWriting.deepseekModel": {
          "order": 5,
          "scope": "application",
          "type": "string",
          "enum": [
            "deepseek-v4-flash",
            "deepseek-v4-pro"
          ],
          "enumDescriptions": [
            "低延迟、低成本，适合实时语法检查和行内补全。",
            "质量优先，延迟和费用更高，适合精细改写。"
          ],
          "default": "deepseek-v4-flash",
          "description": "DeepSeek Chat Completions 模型；请求固定使用非思考模式和低随机性结构化输出。兼容服务必须接受所选模型 ID。"
        },
        "texleaf.aiWriting.deepseekBaseUrl": {
          "order": 6,
          "scope": "application",
          "type": "string",
          "default": "https://api.deepseek.com",
          "description": "DeepSeek Chat Completions API 的 Base URL；TeXLeaf 只请求 {Base URL}/chat/completions。禁止用户名、密码、查询参数、片段和重定向；远程地址必须使用 HTTPS，仅 localhost/127.0.0.1/::1 可使用 HTTP。每个规范化地址都要单独确认并设置 Key；自定义服务的计费、存储和数据政策由其运营方负责。"
        },
        "texleaf.aiWriting.openaiModel": {
          "order": 7,
          "scope": "application",
          "type": "string",
          "default": "gpt-5.6-luna",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "patternErrorMessage": "模型 ID 只能包含字母、数字、点、下划线、冒号、斜杠和连字符，长度为 1–128。",
          "description": "OpenAI Responses 模型 ID。默认 gpt-5.6-luna；也可填写当前 OpenAI Responses 模型或自定义兼容服务的模型 ID。"
        },
        "texleaf.aiWriting.openaiBaseUrl": {
          "order": 8,
          "scope": "application",
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "OpenAI Responses API 的 Base URL；TeXLeaf 只请求 {Base URL}/responses，不兼容仅提供 /chat/completions 的代理。禁止用户名、密码、查询参数、片段和重定向；远程地址必须使用 HTTPS，仅 localhost/127.0.0.1/::1 可使用 HTTP。每个规范化地址都要单独确认并设置 Key；自定义服务的计费、存储和数据政策由其运营方负责。"
        },
        "texleaf.aiWriting.language": {
          "order": 9,
          "scope": "application",
          "type": "string",
          "enum": [
            "auto",
            "english",
            "chinese"
          ],
          "enumDescriptions": [
            "由模型按当前待检查正文自动识别语言。",
            "按英语论文检查，并用中文解释问题。",
            "按中文学术写作检查。"
          ],
          "default": "auto",
          "description": "写作检查语言。"
        },
        "texleaf.aiWriting.style": {
          "order": 10,
          "scope": "application",
          "type": "string",
          "enum": [
            "academic",
            "general",
            "concise"
          ],
          "enumDescriptions": [
            "学术论文：正式、准确并保留专业术语。",
            "通用写作：自然、清晰。",
            "简洁表达：优先删去冗余和含混措辞。"
          ],
          "default": "academic",
          "description": "检查、改写和补全采用的写作风格。"
        },
        "texleaf.aiWriting.reviewDelayMs": {
          "order": 11,
          "scope": "application",
          "type": "integer",
          "default": 900,
          "minimum": 500,
          "maximum": 10000,
          "description": "停止键入后等待多少毫秒再自动检查改动句子。继续输入会取消旧请求，相同句子内容不会在同一文档版本中重复请求。"
        },
        "texleaf.aiWriting.completionDelayMs": {
          "order": 12,
          "scope": "application",
          "type": "integer",
          "default": 500,
          "minimum": 100,
          "maximum": 5000,
          "description": "自动行内补全发出请求前的额外等待时间。"
        },
        "texleaf.aiWriting.maxParagraphLength": {
          "order": 13,
          "scope": "application",
          "type": "integer",
          "default": 6000,
          "minimum": 500,
          "maximum": 20000,
          "description": "单个自动检查句子或手动正文段最多发送的 UTF-16 字符数。设置名 maxParagraphLength 为兼容旧配置而保留；超出时要求缩小选区。"
        },
        "texleaf.aiWriting.maxDocumentLength": {
          "order": 14,
          "scope": "application",
          "type": "integer",
          "default": 30000,
          "minimum": 1000,
          "maximum": 100000,
          "description": "手动检查整篇文档时，本次最多发送的正文 UTF-16 字符数。"
        }
      }
    },
    {
      "title": "TeXLeaf · 预览",
      "properties": {
        "texleaf.mathPreview.enabled": {
          "order": 1,
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "启用 TeXLeaf 内置的实时数学公式预览。渲染资源随扩展提供；灵感来源与致谢见项目 README 和 Wiki。"
        },
        "texleaf.mathPreview.presentation": {
          "order": 2,
          "scope": "resource",
          "type": "string",
          "enum": [
            "cursor",
            "hover",
            "both"
          ],
          "enumDescriptions": [
            "光标进入公式时，在公式旁显示 SVG 预览。",
            "只在鼠标悬停时使用 VS Code 原生 Hover 显示预览。",
            "同时启用光标预览与 Hover；若 LaTeX Workshop 也提供 Hover，可能出现两份内容。"
          ],
          "default": "cursor",
          "description": "选择 Math Preview 的显示方式；默认只跟随活动光标，避免与其他 LaTeX 扩展的 Hover 重复。"
        },
        "texleaf.mathPreview.placement": {
          "order": 3,
          "scope": "resource",
          "type": "string",
          "enum": [
            "auto",
            "above",
            "below"
          ],
          "enumDescriptions": [
            "行内公式始终放在活动源码行下方；行间公式优先放在下方，下方可见空间不足时改到上方，上下均不足时仍保持在上方并保留公式尾部视图。",
            "始终把光标预览放在公式上方。",
            "始终把光标预览放在公式下方。"
          ],
          "default": "auto",
          "description": "选择光标公式预览的浮动方向。行内公式默认位于活动源码行下方：起始行对齐定界符，后续行对齐该行首个非空白字符；行间公式对齐起始定界符。卡片不参与正文换行；VS Code 没有公开的横向视口尺寸或行间占位 API，因此超宽卡片右端可能被裁切，没有空白行时也可能临时遮住相邻行。"
        },
        "texleaf.mathPreview.debounceMs": {
          "order": 4,
          "scope": "resource",
          "type": "integer",
          "default": 120,
          "minimum": 50,
          "maximum": 2000,
          "description": "停止键入或移动光标后等待多少毫秒再更新预览。较大的值更省电；大文档会自动至少使用 300 毫秒。"
        },
        "texleaf.mathPreview.scale": {
          "order": 5,
          "scope": "resource",
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 3,
          "description": "公式 SVG 的显示缩放倍数；光标预览超过 40em 宽度时会等比缩放，256em 高度仅作为异常 TeX 几何的绘制安全上限。"
        },
        "texleaf.mathPreview.maxSourceLength": {
          "order": 6,
          "scope": "resource",
          "type": "integer",
          "default": 8192,
          "minimum": 256,
          "maximum": 32768,
          "description": "单条公式允许送入后台 MathJax 渲染器的最大 UTF-16 字符数，用于限制性能与宏展开风险。"
        },
        "texleaf.mathPreview.macros": {
          "order": 7,
          "scope": "resource",
          "type": "object",
          "default": {},
          "maxProperties": 128,
          "propertyNames": {
            "pattern": "^[A-Za-z@]+$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 2048
          },
          "description": "可选的 MathJax 宏表：最多 128 项，键是不带反斜杠的命令名，值是替换文本；会自动从替换文本中的 #1…#9 推断参数个数。为匹配后台渲染器的安全边界，序列化后总长度超过 16384 个 UTF-16 字符时会按键名顺序忽略超出的定义。文档前言中的 newcommand、renewcommand、providecommand 和 DeclareMathOperator 会覆盖同名设置。"
        }
      }
    }
  ],
